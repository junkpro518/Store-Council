# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Salla app credentials (from Salla Partners portal — https://salla.partners)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
# Must match the callback URL registered for your Salla app
SALLA_REDIRECT_URI=http://localhost:3000/auth/salla/callback
# Optional: webhook signing secret from the Salla app settings
SALLA_WEBHOOK_SECRET=

# Server
PORT=3000

# Daily analysis schedule (cron, server local time). Default: 05:00 every day.
DAILY_CRON=0 5 * * *

# Data directory for tokens, snapshots, reports, chat history
DATA_DIR=./data
