# Everything below is OPTIONAL. The platform is fully configurable from the
# web dashboard (Settings page) — environment variables only provide initial
# defaults and server-level options.

# Server
PORT=3000
DATA_DIR=./data

# Optional initial defaults (all editable later in the dashboard):
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# SALLA_CLIENT_ID=
# SALLA_CLIENT_SECRET=
# SALLA_REDIRECT_URI=http://localhost:3000/auth/salla/callback
# SALLA_WEBHOOK_SECRET=
# DAILY_CRON=0 5 * * *
