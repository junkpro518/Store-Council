{
  "name": "store-council",
  "version": "0.1.0",
  "description": "Store Council \u2014 a multi-agent AI platform that connects read-only to a Salla store, analyzes it daily, and lets the merchant chat with 15 specialist AI department managers. Runs entirely on OpenRouter.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "daily-run": "tsx src/pipeline/runDaily.ts",
    "typecheck": "tsc --noEmit",
    "verify:openrouter": "tsx scripts/verify-openrouter.ts",
    "worker": "node dist/worker.js",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}